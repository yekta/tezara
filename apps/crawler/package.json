{
  "name": "@tezara/crawler",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "probe": "tsx src/probe.ts",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "backfill": "node --experimental-strip-types src/backfill.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "wipe": "node --experimental-strip-types src/wipe.ts"
  },
  "dependencies": {
    "@tezara/clickhouse": "workspace:*",
    "@tezara/core": "workspace:*",
    "@tezara/meili": "workspace:*",
    "cheerio": "1.0.0",
    "ioredis": "5.5.0",
    "playwright": "1.49.1",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
