{
  "name": "tezara",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "web": "pnpm --filter @tezara/web",
    "crawler": "pnpm --filter @tezara/crawler",
    "start": "pnpm --filter @tezara/web start"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "5.9.3"
  }
}
